{
  "name": "slide-genius-backend",
  "version": "1.0.0",
  "description": "Backend API for SlideGenius AI",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "typescript": "^5.2.2",
    "@prisma/client": "^5.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "express-rate-limit": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.5.0",
    "pptxgen-js": "^3.12.0",
    "pdfkit": "^0.13.0",
    "joi": "^17.11.0",
    "helmet": "^7.0.0",
    "express-validator": "^7.0.0",
    "redis": "^4.6.10",
    "sharp": "^0.32.6",
    "slugify": "^1.6.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.9",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^1.4.7",
    "@types/pdfkit": "^0.12.9",
    "tsx": "^3.13.0",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "prisma": "^5.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
